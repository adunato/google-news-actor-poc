{
  "name": "google-news-actor-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier --check README.md AGENTS.md docs .github package.json tsconfig.json eslint.config.js src",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "apify": "^3.7.2"
  }
}
